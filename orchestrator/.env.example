# Backend Orchestrator Environment Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Security
JWT_SECRET=your-super-secure-jwt-secret-change-in-production
REDIS_URL=redis://redis:6379

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:9999

# Service URLs (for production, override these)
AIOS_URL=http://aios:8000
GBOX_URL=http://gbox:29888
BYTEBOT_URL=http://bytebot:4000
OPEN_INTERFACE_URL=http://open-interface:5000
FACTIF_AI_URL=http://factif-ai:7000
POSTIZ_URL=http://postiz-app:9000
ONLYSNARF_URL=http://onlysnarf:10000
REELS_AUTOMATOR_URL=http://reels-clips-automator:11000
WAN2GP_URL=http://wan2gp:12000

# Monitoring
PROMETHEUS_PORT=9091
LOG_LEVEL=info

# Database (if needed for future features)
# DATABASE_URL=postgresql://orchestrator:password@postgres:5432/orchestrator