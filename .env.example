# Unified Application Framework Environment Variables
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
NODE_ENV=development
LOG_LEVEL=info
DEBUG=true

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/unified_framework
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=unified_framework
DATABASE_USER=postgres
DATABASE_PASSWORD=password

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-characters
SSL_CERT_PATH=/path/to/ssl/cert.pem
SSL_KEY_PATH=/path/to/ssl/key.pem

# =============================================================================
# AI API KEYS
# =============================================================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# Google Gemini Configuration
GEMINI_API_KEY=your-gemini-api-key-here

# Groq Configuration
GROQ_API_KEY=gsk_your-groq-api-key-here

# Hugging Face Configuration
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# Novita AI Configuration
NOVITA_API_KEY=your-novita-api-key-here

# =============================================================================
# SERVICE PORTS
# =============================================================================
ORCHESTRATOR_PORT=3000
API_GATEWAY_PORT=8080
BYTEBOT_PORT=3001
FACTIF_AI_PORT=3002
AIOS_PORT=8000
UI_PORT=9992

# =============================================================================
# AIOS SPECIFIC CONFIGURATION
# =============================================================================
AIOS_WORKERS=4
CUDA_VISIBLE_DEVICES=all
ENABLE_GPU=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
FRONTEND_URL=http://localhost:9992
API_GATEWAY_URL=http://localhost:8080
INGRESS_HOST=localhost

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jaeger
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200

# =============================================================================
# DOCKER COMPOSE CONFIGURATION
# =============================================================================
# PostgreSQL
POSTGRES_DB=unified_framework
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Redis
REDIS_COMMANDER_PORT=8081

# PgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Jupyter (for AIOS development)
JUPYTER_TOKEN=dev
JUPYTER_PORT=8888

# Nginx
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =============================================================================
# DEVELOPMENT SPECIFIC
# =============================================================================
# Hot reloading
ENABLE_HOT_RELOAD=true

# Configuration directory
CONFIG_DIR=./config

# Development database
DEV_DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/unified_framework_dev

# Test database
TEST_DATABASE_URL=postgresql://postgres:test_password@localhost:5432/unified_framework_test

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================
# SSL Configuration
ENABLE_HTTPS=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:9992

# =============================================================================
# KUBERNETES SPECIFIC
# =============================================================================
# Namespace
K8S_NAMESPACE=unified-framework

# Service mesh
ENABLE_SERVICE_MESH=false
ENABLE_NETWORK_POLICY=false

# Ingress
ENABLE_INGRESS=false
TLS_ENABLED=false

# =============================================================================
# RESOURCE LIMITS
# =============================================================================
# Memory limits (for Docker/Kubernetes)
ORCHESTRATOR_MEMORY=512Mi
API_GATEWAY_MEMORY=256Mi
BYTEBOT_MEMORY=2Gi
FACTIF_AI_MEMORY=1Gi
AIOS_MEMORY=4Gi
UI_MEMORY=128Mi

# CPU limits
ORCHESTRATOR_CPU=500m
API_GATEWAY_CPU=300m
BYTEBOT_CPU=1000m
FACTIF_AI_CPU=800m
AIOS_CPU=2000m
UI_CPU=200m

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable specific features
ENABLE_DRAG_AND_DROP=true
ENABLE_REAL_TIME_UPDATES=true
ENABLE_SCREENSHOTS=true
ENABLE_HEADLESS_BROWSER=true

# Maximum limits
MAX_WORKFLOW_CARDS=100
MAX_CONCURRENT_TASKS=5
MAX_CONCURRENT_JOBS=3
MAX_AGENTS=10

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup configuration
BACKUP_ENABLED=false
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Email service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# Webhook URLs
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# Enable development tools
ENABLE_SWAGGER=true
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_DEBUG_ENDPOINTS=true

# Testing
TEST_TIMEOUT=30000
TEST_PARALLEL=true