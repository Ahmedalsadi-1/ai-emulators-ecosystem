# Bytebotd Service Environment Variables

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bytebotdb

# Application Commands
BROWSEROS_APP_COMMAND=browseros
BROWSEROS_APP_WMCLASS=browseros.BrowserOS

TURIX_APP_COMMAND=open -a "Turix"
TURIX_APP_WMCLASS=Turix

AIOS_APP_COMMAND=python -m uvicorn runtime.launch:app --host 0.0.0.0 --port 8000
AIOS_APP_WMCLASS=aios.AIOS

OPEN_INTERFACE_APP_COMMAND=open -a "Open Interface"
OPEN_INTERFACE_APP_WMCLASS=Open-Interface

# Service Configuration
PORT=9990
NODE_ENV=development

# NUT Service (Desktop Control)
NUT_HOST=localhost
NUT_PORT=9999

# Logging
LOG_LEVEL=debug

# Authentication (optional)
BYTEBOT_AUTH_ENABLED=false
BYTEBOT_AUTH_SECRET=replace-with-strong-secret
BYTEBOT_AUTH_TTL_SECONDS=3600
BYTEBOT_AUTH_USERS_FILE=./bytebotd.users.json
# BYTEBOT_AUTH_USERS=[{"username":"admin","passwordHash":"salt:hash","role":"admin","createdAt":"2025-01-01T00:00:00.000Z"}]
# BYTEBOT_AUTH_USER=admin
# BYTEBOT_AUTH_PASSWORD=changeme
# BYTEBOT_AUTH_ROLE=admin
BYTEBOT_AUDIT_ENABLED=false

# External Services
AIOS_BASE_URL=http://localhost:8000
FACTIF_AI_BASE_URL=http://localhost:3001
