{
  "name": "unified-visual-automation",
  "version": "1.0.0",
  "description": "Unified visual automation interface combining Turix, OpenInterface, and Factif capabilities",
  "main": "dist/index.js",
  "scripts": {
    "build": "concurrently \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "tsc --project backend/tsconfig.json",
    "build:frontend": "cd frontend && npm run build",
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "node dist/backend/src/server.js",
    "start:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "ts-node-dev --project backend/tsconfig.json backend/src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "jest --config backend/jest.config.js",
    "test:frontend": "cd frontend && npm run test"
  },
  "keywords": [
    "automation",
    "visual-testing",
    "computer-vision",
    "workflow",
    "ai"
  ],
  "author": "Future App Team",
  "license": "MIT",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "concurrently": "^8.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  }
}