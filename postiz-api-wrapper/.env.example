# Postiz API Wrapper Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Postiz API Configuration
POSTIZ_API_URL=http://localhost:3000
POSTIZ_API_KEY=your_postiz_api_key_here
POSTIZ_USERNAME=your_postiz_username
POSTIZ_PASSWORD=your_postiz_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# API Versioning
API_VERSION=v1

# Request Timeout (ms)
REQUEST_TIMEOUT=30000

# Health Check
HEALTH_CHECK_ENABLED=true