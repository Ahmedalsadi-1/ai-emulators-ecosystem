{
  "manifest_version": 3,
  "name": "KRONOS-OS",
  "version": "1.0.0",
  "description": "AI-powered desktop automation platform with multi-workspace control and parallel AI agents",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "512": "icons/icon512.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "activeTab",
    "webNavigation",
    "background"
  ],
  "host_permissions": [
    "http://localhost:9991/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "side_panel": {
    "default_path": "side-panel/side-panel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "css": ["content/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "popup/popup.html",
    "side-panel/side-panel.html"
  ],
  "content_security_policy": {
    "extension_pages": "none"
  },
  "key": "MIIBIICRJBLHEEPMIBMIICRJBLHEEPMIBMIICRJBLHEEP",
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": []
  }
}
